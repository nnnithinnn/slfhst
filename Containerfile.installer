# slfhst installer image: a throwaway live-boot environment (bootc-image-
# builder's bootc-generic-iso type) that partitions disks and deploys the
# real appliance image via `bootc install to-filesystem` -- replaces
# Anaconda/kickstart entirely (see git history for why: %pre/%include
# ordering bugs, non-interactive-mode mandatory-spoke validation, an
# ostree.final-diffid deploy failure caused by squashing the appliance
# image, autopart silently spanning multiple disks -- an opaque target to
# build automation against, each bug only discoverable by burning a real
# install attempt).
#
# FROM the appliance image itself, not a separate base -- this way the
# installer always matches whatever image it's built alongside in the same
# CI run (see .github/workflows/publish.yml), and inherits podman/parted/
# python3/etc. already installed there for free. dracut-live +
# squashfs-tools are the only things bootc-image-builder's bootc-generic-iso
# output type actually needs beyond that: a container image with
# dmsquash-live in its initramfs boots live from a squashfs, full stop --
# no kickstart, no custom PXE/dracut work needed.
#
# The exact dracut invocation to rebuild the initramfs with dmsquash-live
# is the least-verified line in this file -- confirmed the MODULE is what's
# needed (research against bootc-image-builder's own docs), not the exact
# command syntax for this specific dracut/kernel version. Confirm against
# a real local build before trusting this blindly.
FROM localhost/slfhst:latest

# --kver is required, not cosmetic: dracut defaults to building an
# initramfs for the CURRENTLY RUNNING kernel, which inside a container
# build means the build host's own kernel (e.g. a GitHub Actions runner's
# "6.17.0-1022-azure"), not the kernel actually installed in this image --
# confirmed by a real CI failure ("Cannot find module directory" /lib/
# modules/<host-kernel-version> doesn't exist in here). /lib/modules
# has exactly one entry: whatever kernel RPM the almalinux-bootc base
# image installed.
#
# The base image ships several /usr/lib/dracut/dracut.conf.d/*.conf files
# that force-enable lvm/crypt/fips/tpm2-tss/clevis modules for the REAL
# appliance's own boot (see the main Containerfile's comment on
# deliberately not removing lvm2/cryptsetup/clevis) -- but the actual
# clevis dracut MODULE FILES aren't installed, so a real `--force` rebuild
# fails. Found by actually pulling and inspecting the real base image
# locally (`podman run --rm quay.io/almalinuxorg/almalinux-bootc:10 ... ls
# /usr/lib/dracut/dracut.conf.d/`) after two rounds of CI whack-a-mole
# ("Module 'clevis' cannot be found", then 'clevis-pin-tpm2' once the
# first conf file was removed) made clear there was more than one file
# involved -- rather than keep guessing, verify directly. The exact three
# files declaring the modules this installer doesn't need:
#   30-bootc-standard.conf : lvm crypt fips
#   49-bootc-tpm2-tss.conf : tpm2-tss
#   50-bootc-clevis.conf   : clevis clevis-pin-tpm2
# This installer's live-boot squashfs is apparently the first thing to
# ever force dracut to run inside this image directly (ostree/bootc
# regenerates the REAL appliance's initramfs at deploy time, not at
# container-build time, so this gap never previously surfaced).
#
# The installer needs none of LVM/LUKS/TPM/clevis at all -- plain GPT
# partitions only (installer_disks.py), no encrypted root, throwaway
# live environment -- so dropping these three conf files is correct, not
# a workaround, and only affects the installer image's own layer, not the
# real appliance image underneath it.
RUN dnf -y install dracut-live squashfs-tools && \
    rm -f /usr/lib/dracut/dracut.conf.d/30-bootc-standard.conf \
          /usr/lib/dracut/dracut.conf.d/49-bootc-tpm2-tss.conf \
          /usr/lib/dracut/dracut.conf.d/50-bootc-clevis.conf && \
    KVER="$(ls /lib/modules | head -n1)" && \
    dracut --force --add dmsquash-live --kver "$KVER" && \
    dnf clean all

# The appliance image itself, embedded as a local oci-archive so
# installer_deploy.py's `bootc install to-filesystem` never needs network
# during install -- appliance.tar is produced by
# scripts/build_installer_image.py (`podman save --format oci-archive`)
# right before this build, from the exact image this installer is FROM,
# so the two can never drift apart.
COPY appliance.tar /usr/share/slfhst/appliance.tar

RUN systemctl enable slfhst-installer.service

LABEL org.opencontainers.image.title="slfhst-installer" \
      org.opencontainers.image.description="Live installer: partitions disks, deploys the slfhst appliance image, reboots"
