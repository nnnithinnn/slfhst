[Unit]
Description=slfhst stage1: firewalld base rules + Cloudflare-only 443
ConditionPathExists=!/var/lib/slfhst/stage1.done
Requires=firewalld.service
After=slfhst-stage1-ssh-totp.service firewalld.service
Before=slfhst-stage1-done.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/slfhst/stage1_firewall.py
