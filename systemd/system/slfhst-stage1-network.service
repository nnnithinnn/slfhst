[Unit]
Description=slfhst stage1: interactive network setup (DHCP or static) + Quad9 DoT resolved config
ConditionPathExists=!/var/lib/slfhst/stage1.done
After=slfhst-stage1-detect-disks.service getty@tty1.service systemd-user-sessions.service
Before=slfhst-stage1-wizard.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/libexec/slfhst/stage1_network.py
