[Unit]
Description=slfhst interactive installer
# Which single console to bind to is genuinely ambiguous ahead of time
# -- this project's own real-world deployment target is a serial-only
# VPS console, but confirmed directly this session that a VNC/KVM-style
# graphical console (showing the local tty1, not serial) is also a real
# usage pattern. Binding to /dev/ttyS0 left the wizard invisible on a
# VNC session the exact same way binding to /dev/tty1 left it invisible
# on serial -- picked tty1 here as the pragmatic default (the "first"
# console, what a VNC/KVM console shows by default) since kernel/
# systemd's own generic boot messages already mirror to every
# configured console= regardless, so a serial-only user still sees real
# boot progress; only this service's own interactive session needs a
# single concrete TTYPath. Revisit if serial-only users need this too
# (e.g. a per-console template unit) -- not done here, kept minimal.
After=local-fs.target getty@tty1.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/slfhst install
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
