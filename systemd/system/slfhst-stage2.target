[Unit]
Description=slfhst stage 2: render quadlets, deploy, bootstrap backing services
# Every boot: run slfhst-stage1.target to completion first (its own units
# no-op once stage1.done exists), THEN this target -- see disks.py/wizard.py
# for why the gating logic lives in the scripts too, not only here.
Wants=slfhst-stage1.target
After=slfhst-stage1.target
Wants=slfhst-stage2-render-quadlets.service
Wants=slfhst-stage2-deploy.service
Wants=slfhst-stage2-bootstrap-backing.service
Wants=slfhst-stage2-dns-sync.service
Wants=slfhst-stage2-healthcheck.service
Wants=slfhst-stage2-done.service
After=slfhst-stage2-render-quadlets.service
After=slfhst-stage2-deploy.service
After=slfhst-stage2-bootstrap-backing.service
After=slfhst-stage2-dns-sync.service
After=slfhst-stage2-healthcheck.service
After=slfhst-stage2-done.service

[Install]
WantedBy=multi-user.target
