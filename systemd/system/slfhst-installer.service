[Unit]
Description=slfhst installer: partition disks, deploy bootc image, reboot
# /run/initramfs/live is dracut-live's marker that this boot is the live
# squashfs environment -- gates this unit so it's inert if this image is
# ever accidentally booted as (or converted to) a normal disk install.
# Worth confirming against a real boot; this is the least-tested path in
# the whole install redesign (see installer_deploy.py's own docstring).
ConditionPathExists=/run/initramfs/live
After=local-fs.target

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
ExecStart=/usr/libexec/slfhst/installer_deploy.py

[Install]
WantedBy=multi-user.target
