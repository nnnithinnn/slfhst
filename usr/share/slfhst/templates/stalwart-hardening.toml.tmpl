# Layered on top of Stalwart's own auto-generated etc/config.toml via an
# `include` directive, wired up automatically after Stalwart's first start
# (see backing.py's harden_stalwart()) -- not a replacement for that file,
# since hand-writing a complete config.toml risks missing something
# Stalwart's own bootstrap needs (storage backend, certs, admin creds).
#
# GreenCloudVPS (like most VPS providers) already scrubs volumetric L3/L4
# DDoS at the network edge; Cloudflare can't help here at all (Spectrum,
# the thing that proxies raw TCP, is Enterprise-only, not free). This is
# about the layer neither of those covers: abusive-but-legitimate-looking
# connections and auth brute-forcing hitting the mail ports directly.
#
# NOTE: listener names (smtp/submission/submissions/imap/imaptls) and the
# queue.limiter.inbound / server.auto-ban schema below are sourced from
# Stalwart's own QUICKSTART_CONFIG and test configs, not hand-verified
# against a real running instance yet -- confirm against the actual
# generated config.toml at first real deploy (see README open items).

[server.listener.smtp]
max-connections = 512

[server.listener.submission]
max-connections = 256

[server.listener.submissions]
max-connections = 256

[server.listener.imap]
max-connections = 256

[server.listener.imaptls]
max-connections = 256

# Per-source-IP throttling, independent of the max-connections caps above
# (those cap total concurrency; this caps rate per sender).
[[queue.limiter.inbound]]
match = "true"
key = "remote_ip"
rate = "20/1m"
enable = true

[[queue.limiter.inbound]]
match = "true"
key = "remote_ip"
rate = "300/1h"
enable = true

# Auto-ban on repeated auth failures or detected abuse (port-scan-like
# behavior). Deliberately tighter than the SSH-side fail2ban jail (5/10m,
# see totp.py) since these ports take unauthenticated internet traffic
# constantly and legitimate senders essentially never fail auth.
[server.auto-ban]
authentication = "5/2m"
abuse = "3/1m"
