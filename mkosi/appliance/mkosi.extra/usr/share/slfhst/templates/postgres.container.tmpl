# Postgres data dir lives on the FAST disk (/var/lib/containers/...), not
# /srv/data -- it's the IOPS-sensitive backing service for Ente museum.
[Unit]
Description=Postgres (backing store for Ente museum)
After=slfhst-network.network

[Container]
Image=docker.io/library/postgres:16-alpine
AutoUpdate=registry
Network=slfhst-network.network
Volume=postgres-data.volume:/var/lib/postgresql/data
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_USER=museum
Environment=POSTGRES_DB=museum

[Service]
Restart=always
