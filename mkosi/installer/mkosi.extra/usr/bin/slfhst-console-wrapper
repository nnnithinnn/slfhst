#!/bin/bash
# Root's login shell in the live installer environment (set via
# mkosi.conf's RootShell=, applied through mkosi's own build-time
# `systemd-firstboot --root-shell=` invocation -- NOT a postinst
# `usermod` call, which turned out not to survive to the final image
# since mkosi.postinst.chroot scripts run before mkosi's own automatic
# systemd-firstboot step, and were silently overridden). Every console
# auto-logs in as root (see the getty@.service/serial-getty@.service
# autologin drop-ins) since it's genuinely ambiguous ahead of time
# which single console the admin is actually watching -- kernel/tty1/
# VNC, or serial.
# So instead of guessing, every console reaches this same decision
# point: whichever one gets here first starts the installer (a flock on
# a shared lockfile makes this race-safe across concurrent logins on
# different consoles); every other console, and this same one again if
# it logs back in after the installer exits, drops to a plain root
# shell instead of silently re-running (or double-running) the
# installer.
set -uo pipefail

cat /etc/motd

exec 9>/run/slfhst-install.lock
if flock -n 9 && [ ! -e /run/slfhst-install.ran ]; then
	touch /run/slfhst-install.ran
	/usr/bin/slfhst install
fi

exec /bin/bash -l
