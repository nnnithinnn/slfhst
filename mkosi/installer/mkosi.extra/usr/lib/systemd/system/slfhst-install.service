[Unit]
Description=slfhst interactive installer
After=local-fs.target getty@tty1.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/slfhst install
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
