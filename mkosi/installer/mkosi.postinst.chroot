#!/bin/bash
# Sets root's login shell to the console wrapper (see mkosi.extra's
# usr/bin/slfhst-console-wrapper) -- runs after package installation so
# the real root passwd entry (from the base packages' own sysusers.d
# content) already exists; usermod only touches the shell field, unlike
# shipping a static /etc/passwd via mkosi.extra which would clobber
# every other account package installs already created. No network
# needed, confirmed this session that mkosi.postinst.chroot doesn't
# have any anyway.
set -euo pipefail
usermod -s /usr/bin/slfhst-console-wrapper root
